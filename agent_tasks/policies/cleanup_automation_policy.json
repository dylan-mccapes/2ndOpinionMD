{
  "policy_id": "cleanup_automation_policy_v1",
  "description": "Automation policy for legacy stack removal and refactoring tasks in 2ndOpinionMD-MVP.",
  "trigger_scope": "repo_cleanup",
  "rules": [
    {
      "task_type": "stack_cleanup",
      "confidence_threshold": 0.7,
      "auto_execute": true,
      "requires_human_review": {
        "if": [
          { "condition": "unit_tests_fail" },
          { "condition": "files_modified", "greater_than": 50 },
          { "condition": "external_dependencies_added", "value": true }
        ],
        "else": false
      }
    }
  ],
  "fallback_contact": "dylan@2ndopinionmd.ai"
}
