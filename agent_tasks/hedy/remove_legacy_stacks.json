{
  "task": "remove_legacy_stacks",
  "description": "Remove all MongoDB, ChromaDB, Node.js, and Express.js components from the 2ndOpinionMD codebase. Ensure PostgreSQL + pgvector is the sole backend stack.",
  "steps": [
    {
      "action": "delete_files_and_dirs",
      "targets": [
        "server/models/mongodb/",
        "server/utils/mongodb/",
        "server/vectordb/chroma_query_engine.py",
        "server/vectordb/chroma_vector_store.py",
        "frontend/node/",
        "frontend/express/",
        "api/chroma_*",
        "scripts/chroma_*"
      ]
    },
    {
      "action": "remove_imports",
      "search": ["from chromadb", "import chromadb", "motor.motor_asyncio", "from pymongo"],
      "files": "all Python source files"
    },
    {
      "action": "remove_requirements",
      "packages": ["chromadb", "motor", "pymongo"],
      "files": ["requirements.txt", "pyproject.toml"]
    },
    {
      "action": "verify_builds",
      "description": "Ensure React builds, FastAPI apps run, and no imports are broken"
    },
    {
      "action": "create_status_file",
      "output": "agent_tasks/devin/status_report.json"
    }
  ],
  "output": {
    "pr_branch": "hedy/cleanup-remove-legacy",
    "summary_file": "agent_tasks/devin/cleanup_summary.md"
  }
}
