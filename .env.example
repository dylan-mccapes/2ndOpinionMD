# 2ndOpinionMD-MVP .env.example — from SpellBook / game_plans/ENV_STRATEGY.md
# Copy to .env or server/.env; fill values. Do not commit real secrets.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_ENV=local
DATABASE_URL=
SYNC_DATABASE_URL=
POSTGRES_DSN=postgres://localhost/2ndopinionmd
PGPOOL_MAX=10
HOST=0.0.0.0
PORT=8000
LOG_DIR=./logs
LOG_ENCRYPTION_KEY_PATH=log_encryption.key
CORS_ALLOW_ORIGINS=https://2ndopinionmd.ai,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8010,http://localhost:8010

# ---------------------------------------------------------------------------
# shared/config/settings.py
# ---------------------------------------------------------------------------
# DATABASE_TYPE=postgresql
# POSTGRESQL_URL=
# VECTOR_ENGINE=pgvector
OPENAI_API_KEY=
# MODEL_VERSION=gpt-3.5-turbo
SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# DEBUG=False
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM / RAG (stream_config, rag_routes)
# ---------------------------------------------------------------------------
CHAT_MODEL=gpt-4.1-mini
# CHAT_MODEL_GUIDELINES= (default: CHAT_MODEL)
# CHAT_MODEL_CODING_CORE= (default: CHAT_MODEL)
# CHAT_MODEL_UTIL= (default: CHAT_MODEL)
# EMBED_MODEL=text-embedding-3-small
VALYU_BASE_URL=
VALYU_API_KEY=
VALYU_TIMEOUT=20.0
# RAG_SOURCE_GATING_ENABLED=1
# RAG_MIN_DOCS_PER_SOURCE=1
# RAG_REL_SCORE_CUTOFF=0.35
# RAG_ABS_SCORE_CUTOFF=0.0
# RAG_ALWAYS_KEEP_SOURCES=
# RAG_TS_PIN_* (see ENV_STRATEGY.md)
# EOH_TIMELINE_RAG_SUMMARY_ENABLED=1
# CODE_MIN_LIMIT=32
# RAG_USE_CODES=1 RAG_USE_GUIDELINES=1 RAG_USE_REST=1
# RAG_K_CODES=64 RAG_K_GUIDELINES=4
# RAG_CODE_MIN_*=10 RAG_CODE_MAX_PER_SOURCE_CTX=16

# ---------------------------------------------------------------------------
# Timeline / EOH
# ---------------------------------------------------------------------------
# TIMELINE_EMBEDDING_MODEL=text-embedding-3-small
# EOH_TIMELINE_ANN_EMBED_MODEL=text-embedding-3-small
# TIMELINE_EMBED_MODEL=text-embedding-3-small
# EOH_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Email / auth (see SpellBook 2opmd_email_credentials — store in .env so not lost on venv crash)
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# EMAIL_DEV_MODE=0
# EMAIL_PROVIDER=fastmail
# MAIL_USERNAME=dylan@2ndopinionmd.ai
# MAIL_PASSWORD=<Gmail App Password for 2ndOpinionMD-MVP — 16 chars, no spaces; store in .env>
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SSL_TLS=false
# MAIL_STARTTLS=true
# REPORT_EMAIL_FROM=dylan@2ndopinionmd.ai
# USE_CREDENTIALS=True

# ---------------------------------------------------------------------------
# API keys / script-only (see ENV_STRATEGY.md § All entries)
# ---------------------------------------------------------------------------
DISGENET_TOKEN=
SCICRUNCH_API_KEY=
# DB_HOST=localhost DB_PORT=5432 DB_USER= DB_PASSWORD= DB_NAME=2ndopinionmd
# SNOMED_ROOT=data SNOMED_LANG_FILE=
# ICD10_MAIN_CODES_FILE= ICD10_ADDENDA_FILE=
# MIMIC_CODING_EVAL_DIR= PGDATABASE=2ndopinionmd
# MONGO_URI= MONGO_DB_NAME=2ndopinionmd
# PANELAPP_*= REPORTS_AI_MODEL=gpt-4o-mini
# CHROMA_PERSIST_DIR= (legacy)
