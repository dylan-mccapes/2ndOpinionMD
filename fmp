#!/usr/bin/env bash

set -e

cmd="$1"
shift || true

case "$cmd" in
  query)
    if [ $# -lt 1 ]; then
      echo "Usage: fmp query \"<thoughtful query>\""
      echo "A thoughtful query: references known files/subsystems/concepts, targets a specific uncertainty, assumes existing context."
      echo "Examples:"
      echo "  - \"ANN grounding for ai_probe/probe_agent.py gap detection flow\""
      echo "  - \"Repo_vision drift between probe_agent citations and ai_coder reports\""
      echo "  - \"How gap_agent ranks lexical vs ANN hits for probe_report sections\""
      exit 1
    fi
    python3 ai_code_pipelines/ai_probe/query_only.py --query "$*"
    ;;
  *)
    echo "Usage: fmp query \"<thoughtful query>\""
    exit 1
    ;;
esac

