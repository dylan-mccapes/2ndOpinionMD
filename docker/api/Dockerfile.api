# docker/Dockerfile.api
FROM python:3.12-slim

# System deps you almost certainly need (psycopg2, etc.)
# Retry to handle transient Debian mirror hash mismatches.
RUN set -eux; \
    for attempt in 1 2 3 4 5; do \
      rm -rf /var/lib/apt/lists/*; \
      apt-get clean; \
      if apt-get update && apt-get install -y --no-install-recommends --fix-missing \
        build-essential \
        libpq-dev; then \
        break; \
      fi; \
      echo "apt install failed (attempt ${attempt}), retrying..."; \
      sleep 3; \
    done; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only dependency files first (for better caching)
# Adjust these if your requirements live elsewhere
COPY server/requirements.txt /app/server/requirements.txt

RUN pip install --no-cache-dir -r /app/server/requirements.txt

# Now copy the rest of the project
COPY . /app

ENV PYTHONUNBUFFERED=1

# Use your docker env file values
ENV APP_ENV=production

# Expose API port
EXPOSE 8000

ENV PYTHONPATH=/app

CMD ["python", "-m", "server.scripts.run_postgres_app"]
