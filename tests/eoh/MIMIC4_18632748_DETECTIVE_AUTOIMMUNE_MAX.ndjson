event: evidence_map
data: {"claims": [{"id": "c1", "text": "The patient's diagnostic landscape evolved from a non-specific 'other' autoimmune weighting early in the timeline to a moderately dominant RA-like profile (55% RA-like weight by 2153), reflecting clearer autoimmune characterization over time.", "category": "diagnostic_landscape", "supporting_evidence_ids": ["patient_diagnostic_landscape_history:MIMIC4_18632748", "patient_timeline_diagnostic_landscape:MIMIC4_18632748"], "support_strength": "strong"}, {"id": "c2", "text": "Early in the disease course (2144), the patient exhibited persistent systemic inflammation evidenced by elevated ESR (67 mm/hr) and CRP (34.9 mg/L), along with hematologic abnormalities including anemia, thrombocytosis, and neutrophilia.", "category": "flare_risk", "supporting_evidence_ids": ["eoh_patient_state_param:MIMIC4_18632748", "patient_timeline:MIMIC4_18632748"], "support_strength": "strong"}, {"id": "c3", "text": "Cardiovascular involvement progressed significantly, marked by atrial fibrillation, presence of a prosthetic heart valve, multiple cardiac ICU admissions, and laboratory evidence of coagulopathy, necessitating chronic anticoagulation and complex management balancing stroke prevention and bleeding risk.", "category": "trajectory", "supporting_evidence_ids": ["patient_timeline:MIMIC4_18632748", "gap:guideline_cardiovascular_involvement:11244804", "gap:guideline_cardiovascular_involvement:11244801", "gap:guideline_cardiovascular_involvement:11243310", "gap:guideline_cardiovascular_involvement:11243311"], "support_strength": "strong"}, {"id": "c4", "text": "Hepatic involvement is characterized by intermittent elevations in liver enzymes (ALT and AST ranging 42–63 IU/L) from early through late timeline, suggestive of evolving liver stress or damage potentially due to autoimmune hepatitis, amyloid-related changes, or medication toxicity.", "category": "trajectory", "supporting_evidence_ids": ["patient_timeline:MIMIC4_18632748", "11245676", "11246857", "gap:guideline_hepatic_involvement:11245677", "gap:guideline_hepatic_involvement:11245650", "gap:guideline_hepatic_involvement:11246877", "gap:guideline_hepatic_involvement:11246876"], "support_strength": "moderate"}, {"id": "c5", "text": "The patient’s multisystem autoimmune disease trajectory involves ongoing moderate to high immunologic activity affecting musculoskeletal, cardiovascular, hematologic, and hepatic systems, with recurrent flares and instability phases indicated by multiple ICU admissions.", "category": "trajectory", "supporting_evidence_ids": ["eoh_patient_state_param:MIMIC4_18632748", "patient_timeline:MIMIC4_18632748"], "support_strength": "strong"}, {"id": "c6", "text": "Longitudinal management requires balancing immunosuppression to control RA-like disease activity with anticoagulation for atrial fibrillation and prosthetic valve, while monitoring for hepatic toxicity and organ damage, guided by ACR/EULAR, ACC/AHA, and AASLD practice guidelines.", "category": "guideline", "supporting_evidence_ids": ["gap:guideline_cardiovascular_involvement:11244804", "gap:guideline_cardiovascular_involvement:11244801", "gap:guideline_cardiovascular_involvement:11243310", "gap:guideline_cardiovascular_involvement:11243311", "11245676", "11246857", "gap:guideline_hepatic_involvement:11245677", "gap:guideline_hepatic_involvement:11245650", "gap:guideline_hepatic_involvement:11246877", "gap:guideline_hepatic_involvement:11246876"], "support_strength": "strong"}, {"id": "c7", "text": "Safety considerations include close monitoring of liver enzymes for potential drug-induced hepatotoxicity, stroke risk management in atrial fibrillation with prosthetic valve anticoagulation, and screening for cardiac amyloidosis given recurrent cardiac ICU admissions and heart failure features.", "category": "guideline", "supporting_evidence_ids": ["gap:guideline_cardiovascular_involvement:11243310", "gap:guideline_cardiovascular_involvement:11243311", "11245676", "11246857"], "support_strength": "moderate"}, {"id": "c8", "text": "Limitations in the data include lack of detailed medication records, imaging, and cardiac function parameters, which constrain precise staging of organ damage and direct attribution of treatment effects; thus, treatment impact is inferred from lab trends and clinical events.", "category": "other", "supporting_evidence_ids": ["eoh_patient_state_param:MIMIC4_18632748"], "support_strength": "moderate"}], "step_id": "C2"}

