event: evidence_map
data: {"claims": [{"id": "c1", "text": "This patient has a complex autoimmune disease history predominantly consistent with rheumatoid arthritis (RA), with a diagnostic landscape weighted approximately 55% RA-like and 45% other overlapping comorbidities.", "category": "diagnostic_landscape", "supporting_evidence_ids": ["patient_timeline_diagnostic_landscape:MIMIC4_18632748"], "support_strength": "strong"}, {"id": "c2", "text": "The patient’s longstanding anticoagulation therapy for a prosthetic heart valve and atrial fibrillation requires careful management to balance the risks of thromboembolism and bleeding, given narrow therapeutic windows and laboratory evidence of coagulation abnormalities.", "category": "flare_risk", "supporting_evidence_ids": ["patient_timeline:MIMIC4_18632748", "chest_vte_2021", "acc_aha_afib_2019"], "support_strength": "strong"}, {"id": "c3", "text": "Immunosuppressive therapies for RA must be cautiously titrated due to persistent systemic inflammation, abnormal liver enzymes, and hematologic abnormalities, with guideline recommendations favoring minimizing glucocorticoid exposure to reduce long-term toxicity.", "category": "flare_risk", "supporting_evidence_ids": ["acr_ra_2021", "patient_timeline:MIMIC4_18632748"], "support_strength": "strong"}, {"id": "c4", "text": "Neuropsychiatric comorbidities such as major depressive disorder and PTSD significantly impact medication adherence and complicate shared decision-making, necessitating integrated mental health support and multidisciplinary care to optimize treatment adherence and disease control.", "category": "flare_risk", "supporting_evidence_ids": ["valyu_raw:bc66e3df-55e9-48ab-ae5e-979c3d73970d:PMC9776108:0", "patient_timeline:MIMIC4_18632748"], "support_strength": "moderate"}, {"id": "c5", "text": "Medication adherence is a major modifiable risk factor; inconsistent use of anticoagulants or immunosuppressives can precipitate RA flares or anticoagulation failure with potentially catastrophic complications.", "category": "flare_risk", "supporting_evidence_ids": ["patient_timeline:MIMIC4_18632748"], "support_strength": "moderate"}, {"id": "c6", "text": "Guidelines recommend preference-sensitive adjustments of immunosuppressive therapies in RA to achieve target disease activity while minimizing glucocorticoid exposure, and tailored anticoagulation strategies in patients with mechanical heart valves and atrial fibrillation to balance bleeding and thromboembolism risks.", "category": "guideline", "supporting_evidence_ids": ["acr_ra_2021", "chest_vte_2021", "acc_aha_afib_2019"], "support_strength": "strong"}, {"id": "c7", "text": "Regular and close laboratory monitoring of inflammatory markers, liver function, hematology, and coagulation parameters is critical to balance treatment risks and benefits in this complex patient.", "category": "other", "supporting_evidence_ids": ["patient_timeline:MIMIC4_18632748", "chest_vte_2021"], "support_strength": "strong"}, {"id": "c8", "text": "The patient’s multiple ICU admissions for cardiovascular or systemic decompensations highlight a fragile multisystem status that increases the complexity and risk of treatment adjustments.", "category": "trajectory", "supporting_evidence_ids": ["patient_timeline:MIMIC4_18632748"], "support_strength": "strong"}], "step_id": "D1"}

