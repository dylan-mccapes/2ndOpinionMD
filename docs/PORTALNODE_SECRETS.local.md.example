# Copy to `docs/PORTALNODE_SECRETS.local.md` (gitignored) or merge into `.env.portalnode`.

# PortalNode pilot PostgreSQL (WSL on RTX-4090 host DESKTOP-KOMPK5V)
PORTALNODE_DB_NAME=portalnode
PORTALNODE_DB_USER=portalnode
PORTALNODE_DB_PASSWORD=__SET_FROM_INSTALL_OUTPUT__

# App / scripts (TCP — required when WSL login ≠ portalnode; peer fails on Unix socket)
SYNC_DATABASE_URL=postgresql://portalnode:__PASSWORD__@127.0.0.1:5432/portalnode
DATABASE_URL=postgresql://portalnode:__PASSWORD__@127.0.0.1:5432/portalnode
POSTGRES_URL=postgresql://portalnode:__PASSWORD__@127.0.0.1:5432/portalnode
